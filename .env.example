# ─────────────────────────────────────────────────────────────
# Diana's OS — environment variables
# Copy to .env.local and fill in. The app runs on SAMPLE DATA with
# none of these set (great for a first look); wire these up to go live.
# ─────────────────────────────────────────────────────────────

# Supabase (Phase 1) — the app's own database / cache over Rechat + Notion
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Annual GCI goal driving the "how am I doing?" gauge (USD)
NEXT_PUBLIC_GCI_ANNUAL_GOAL=750000

# ── Integrations ──
# Rechat (primary CRM / source of truth) — OAuth 2.0 Authorization Code flow.
# Request a partner app from Rechat (issued, not self-serve). When you request
# it, give them your redirect URI: <APP_BASE_URL>/api/auth/rechat/callback
# Then visit /api/auth/rechat/start once to connect. Sync + webhook light up.
RECHAT_CLIENT_ID=
RECHAT_CLIENT_SECRET=
RECHAT_WEBHOOK_SECRET=
RECHAT_API_BASE=https://api.rechat.com
RECHAT_AUTH_HOST=https://app.rechat.com
# Optional: override the redirect URI (defaults to APP_BASE_URL + callback path).
RECHAT_REDIRECT_URI=
# Optional: bootstrap with a refresh token instead of the browser flow.
RECHAT_REFRESH_TOKEN=

# Notion (NOVA OS / "the NOS") — Phase 2
NOTION_TOKEN=
NOTION_DB_TASKS=
NOTION_DB_CONTACTS=
NOTION_DB_SOPS=
NOTION_DB_SELLER_DISCOVERY=

# Calendly (booked appointments feed) — Phase 3
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# DocuSign (only if signing outside Rechat) — Phase 3, optional
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=

# Notifications — Phase 2/3
RESEND_API_KEY=
RESEND_FROM=Diana's OS <brief@dianamarsh.com>
MORNING_BRIEF_TO=diana@example.com
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Protects the cron endpoints (Vercel Cron sends it as a Bearer header)
CRON_SECRET=

# App
APP_BASE_URL=http://localhost:3000

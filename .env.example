# ─────────────────────────────────────────────────────────────
# Diana's OS — environment variables
# Copy to .env.local and fill in. The app runs on SAMPLE DATA with
# none of these set (great for a first look); wire these up to go live.
# ─────────────────────────────────────────────────────────────

# Supabase (Phase 1) — the app's own database / cache over Rechat + Notion
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Annual GCI goal driving the "how am I doing?" gauge (USD)
NEXT_PUBLIC_GCI_ANNUAL_GOAL=750000

# ── Integrations ──
# Rechat (primary CRM / source of truth) — OAuth 2.0 partner app.
# Request these from Rechat (they are issued, not self-serve). Sync + webhook
# light up automatically once CLIENT_ID + CLIENT_SECRET are set.
RECHAT_CLIENT_ID=
RECHAT_CLIENT_SECRET=
RECHAT_WEBHOOK_SECRET=
RECHAT_API_BASE=https://api.rechat.com
# Optional overrides (defaults derived from API_BASE):
RECHAT_TOKEN_URL=
RECHAT_GRANT_TYPE=client_credentials
# Only if Rechat provisions a password grant for your app:
RECHAT_USERNAME=
RECHAT_PASSWORD=

# Notion (NOVA OS / "the NOS") — Phase 2
NOTION_TOKEN=
NOTION_DB_TASKS=
NOTION_DB_CONTACTS=
NOTION_DB_SOPS=
NOTION_DB_SELLER_DISCOVERY=

# Calendly (booked appointments feed) — Phase 3
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# DocuSign (only if signing outside Rechat) — Phase 3, optional
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=

# Notifications — Phase 2/3
RESEND_API_KEY=
RESEND_FROM=Diana's OS <brief@dianamarsh.com>
MORNING_BRIEF_TO=diana@example.com
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Protects the cron endpoints (Vercel Cron sends it as a Bearer header)
CRON_SECRET=

# App
APP_BASE_URL=http://localhost:3000
